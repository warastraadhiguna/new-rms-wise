<Window x:Class="Pos.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Pos.Desktop.Views"
        xmlns:vm="clr-namespace:Pos.Desktop.ViewModels"
        Title="{Binding NodeName, StringFormat=POS - {0}}" Width="1366" Height="768"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        FontFamily="Tahoma" FontSize="13" Background="#DCE6F4">
    <Window.InputBindings>
        <KeyBinding Key="F2" Command="{Binding OpenSalesFormCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <DataTemplate DataType="{x:Type vm:SalesViewModel}">
            <views:SalesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StockTotalViewModel}">
            <views:StockTotalView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StockCardViewModel}">
            <views:StockCardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StockCheckViewModel}">
            <views:StockCheckView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LocationTransferViewModel}">
            <views:LocationTransferView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReturnFormViewModel}">
            <views:ReturnFormView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReturnListViewModel}">
            <views:ReturnListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SalesListViewModel}">
            <views:SalesListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LocationTransferListViewModel}">
            <views:LocationTransferListView />
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Menu per group as in RMS 2; a group is shown only when the user has its permission. -->
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" Background="#EEF3FA" Padding="2">
            <MenuItem x:Name="SalesMenu" Header="_Penjualan"
                      Visibility="{Binding ShowSalesMenu, Converter={StaticResource BoolToVisibility}}">
                <MenuItem x:Name="SalesFormMenuItem" Header="Form Penjualan" InputGestureText="F2"
                          Command="{Binding OpenSalesFormCommand}" IsEnabled="{Binding CanSell}"
                          Visibility="{Binding HasSalesMenu, Converter={StaticResource BoolToVisibility}}" />
                <MenuItem x:Name="SalesListMenuItem" Header="Data Penjualan" Command="{Binding OpenSalesListCommand}"
                          Visibility="{Binding CanViewSales, Converter={StaticResource BoolToVisibility}}" />
                <MenuItem x:Name="ReturnListMenuItem" Header="Data Retur Penjualan" Command="{Binding OpenReturnListCommand}"
                          Visibility="{Binding CanViewSales, Converter={StaticResource BoolToVisibility}}" />
                <MenuItem x:Name="SalesLockMenuItem" Header="{Binding SalesLockText}" IsEnabled="False" FontStyle="Italic"
                          Visibility="{Binding IsSalesLocked, Converter={StaticResource BoolToVisibility}}" />
                <Separator Visibility="{Binding CanCloseShift, Converter={StaticResource BoolToVisibility}}" />
                <MenuItem x:Name="CloseShiftMenuItem" Header="Tutup Shift" InputGestureText="Ctrl+F12"
                          Command="{Binding CloseShiftCommand}"
                          Visibility="{Binding CanCloseShift, Converter={StaticResource BoolToVisibility}}" />
            </MenuItem>
            <MenuItem x:Name="StockMenu" Header="_Stok"
                      Visibility="{Binding ShowStockMenu, Converter={StaticResource BoolToVisibility}}">
                <MenuItem x:Name="StockTotalMenuItem" Header="Stok Total" Command="{Binding OpenStockTotalCommand}"
                          Visibility="{Binding CanViewStock, Converter={StaticResource BoolToVisibility}}" />
                <MenuItem x:Name="StockCheckMenuItem" Header="Cek Stok" Command="{Binding OpenStockCheckCommand}"
                          Visibility="{Binding CanViewStock, Converter={StaticResource BoolToVisibility}}" />
                <Separator Visibility="{Binding CanViewStock, Converter={StaticResource BoolToVisibility}}" />
                <MenuItem x:Name="LocationTransferMenuItem" Header="Form Mutasi Lokasi" Command="{Binding OpenLocationTransferCommand}"
                          Visibility="{Binding CanTransfer, Converter={StaticResource BoolToVisibility}}" />
                <MenuItem x:Name="LocationTransferListMenuItem" Header="Daftar Mutasi Lokasi" Command="{Binding OpenLocationTransferListCommand}" />
            </MenuItem>
            <MenuItem x:Name="ReportMenu" Header="_Laporan"
                      Visibility="{Binding CanViewStock, Converter={StaticResource BoolToVisibility}}">
                <MenuItem x:Name="StockCardMenuItem" Header="Kartu Stok" Command="{Binding OpenStockCardCommand}" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Pengguna:" />
                    <Run Text="{Binding CashierName, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Shift:" />
                    <Run Text="{Binding ShiftNumber, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Toko:" />
                    <Run Text="{Binding NodeName, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
            </StatusBarItem>
            <Separator Visibility="{Binding HasSync, Converter={StaticResource BoolToVisibility}}" />
            <StatusBarItem Visibility="{Binding HasSync, Converter={StaticResource BoolToVisibility}}">
                <TextBlock x:Name="SyncStatusText" Text="{Binding Sync.Text, Mode=OneWay}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Sync.IsAlert}" Value="True">
                                    <Setter Property="Foreground" Value="#C62828" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <!-- Every form is a tab "Title ×" (RMS 2 style). -->
            <TabControl x:Name="FormTabs" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                        Background="#EEF3FA" Padding="0" Margin="4,4,4,0"
                        Visibility="{Binding HasTabs, Converter={StaticResource BoolToVisibility}}">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                            <Button x:Name="CloseTabButton" Content="×" Margin="8,0,0,0" Padding="4,0" BorderThickness="0"
                                    Background="Transparent" Focusable="False" ToolTip="Tutup [Esc]"
                                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
            </TabControl>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasTabs}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Button x:Name="OpenSalesButton" Content="Form Penjualan [F2]" Command="{Binding OpenSalesFormCommand}"
                        Padding="16,6" FontSize="15" Margin="0,0,0,8"
                        Visibility="{Binding CanSell, Converter={StaticResource BoolToVisibility}}" />
                <Button x:Name="OpenStockTotalButton" Content="Stok Total" Command="{Binding OpenStockTotalCommand}"
                        Padding="16,6" FontSize="15"
                        Visibility="{Binding CanViewStock, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
