<Window x:Class="Pos.Desktop.Views.Dialogs.PickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Pos.Desktop.Infrastructure"
        Title="{Binding Title}" Width="820" Height="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Tahoma" FontSize="13"
        infra:DialogCloser.DialogResult="{Binding DialogResult}"
        Loaded="OnLoaded">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6"
                   Visibility="{Binding IsSearchable, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Cari" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="QueryBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Padding="3"
                     infra:SearchNavigation.Results="{Binding ElementName=ItemsGrid}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding ChooseCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>
        <TextBlock x:Name="ErrorText" DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Foreground="Firebrick" Margin="0,6,0,0" />
        <TextBlock DockPanel.Dock="Bottom" Text="↓ = ke daftar, ↑ di baris teratas = ke kotak cari, Enter = pilih, Esc = batal" Foreground="Gray" Margin="0,6,0,0" />
        <DataGrid x:Name="ItemsGrid" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" RowHeight="22"
                  CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="All"
                  HorizontalGridLinesBrush="#D5DCE6" VerticalGridLinesBrush="#D5DCE6"
                  infra:PickerColumnsBehavior.Columns="{Binding Columns}">
            <DataGrid.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding ChooseCommand}" />
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding ChooseCommand}" />
            </DataGrid.InputBindings>
        </DataGrid>
    </DockPanel>
</Window>
