<Window x:Class="Pos.Desktop.Views.Dialogs.SupervisorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Pos.Desktop.Infrastructure"
        Title="Persetujuan Supervisor" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Tahoma" FontSize="13"
        infra:DialogCloser.DialogResult="{Binding DialogResult}"
        FocusManager.FocusedElement="{Binding ElementName=UsernameBox}">
    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding OkCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>
    <StackPanel Margin="16">
        <TextBlock Text="{Binding Purpose}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBlock Text="Username supervisor" />
        <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Padding="3" Margin="0,2,0,8" />
        <TextBlock Text="Password supervisor" />
        <PasswordBox x:Name="PasswordInput" infra:PasswordBoxBinding.BoundPassword="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                     Padding="3" Margin="0,2,0,0" />
        <TextBlock x:Name="ErrorText" Text="{Binding ErrorMessage}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,6,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="OkButton" Content="OK [Enter]" Command="{Binding OkCommand}" Padding="12,3" Margin="0,0,8,0" />
            <Button x:Name="CancelButton" Content="Batal [Esc]" Command="{Binding CancelCommand}" Padding="12,3" />
        </StackPanel>
    </StackPanel>
</Window>
