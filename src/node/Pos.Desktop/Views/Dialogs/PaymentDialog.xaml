<Window x:Class="Pos.Desktop.Views.Dialogs.PaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Pos.Desktop.Infrastructure"
        Title="Form Bayar Nota" Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Tahoma" FontSize="14" Background="#EEF3FA"
        infra:DialogCloser.DialogResult="{Binding DialogResult}"
        infra:FocusBehavior.Request="{Binding FocusRequest}"
        infra:EnterNavigation.IsEnabled="True">
    <!--
      Exactly as RMS 2 "Form Bayar Nota" (docs/rms2/form-bayar.png):
      Cara Bayar, Total, [Potongan|Diskon], Grand Total, Bayar, Kembali, Keterangan, Referensi.
      Focus starts on Bayar. Enter: Bayar / Keterangan / Referensi = save; Potongan/Diskon -> Bayar.
    -->
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
        <KeyBinding Key="F4" Command="{Binding PickMemberCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <infra:IndonesianNumberConverter x:Key="Number" />
        <infra:VisibleWhenTextConverter x:Key="VisibleWhenText" />
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3,10,3" />
        </Style>
        <Style x:Key="DimLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Foreground" Value="#8A8A8A" />
        </Style>
        <Style x:Key="ReadOnly" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="#E3E9F2" />
            <Setter Property="BorderBrush" Value="#C8D3E3" />
            <Setter Property="Padding" Value="3,2" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Padding" Value="3,2" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="14,12">
        <TextBlock x:Name="MemberText" Text="{Binding CustomerName, StringFormat=Member: {0}}" Margin="0,0,0,6" FontWeight="SemiBold"
                   Visibility="{Binding CustomerName, Converter={StaticResource VisibleWhenText}}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Fixed, wide enough for the longest label of every method ("Uang Muka (DP)"), so boxes never shift. -->
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>

            <!-- 0 Cara Bayar -->
            <TextBlock Grid.Row="0" Text="Cara Bayar" Style="{StaticResource Label}" />
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="MethodBox" Margin="0,3"
                      infra:FocusBehavior.Key="method" infra:EnterNavigation.Next="discount"
                      ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding SelectedMethod}" DisplayMemberPath="Name" />

            <!-- 1 Total (cart, before Potongan/Diskon) -->
            <TextBlock Grid.Row="1" Text="Total" Style="{StaticResource Label}" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TotalBox" Style="{StaticResource ReadOnly}"
                     Text="{Binding Total, Mode=OneWay, Converter={StaticResource Number}}" />

            <!-- 2 [Potongan|Diskon] + value -->
            <ComboBox Grid.Row="2" x:Name="DiscountModeBox" Margin="0,3,8,3"
                      infra:FocusBehavior.Key="discountMode" infra:EnterNavigation.Next="discount"
                      ItemsSource="{Binding DiscountModes}" SelectedIndex="{Binding DiscountModeIndex}" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="DiscountBox" Style="{StaticResource Input}"
                     infra:MoneyBox.IsEnabled="True"
                     infra:FocusBehavior.Key="discount" infra:EnterNavigation.Next="bayar"
                     Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}" />

            <!-- 3 Grand Total (large) -->
            <TextBlock Grid.Row="3" Text="Grand Total" Style="{StaticResource DimLabel}" />
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="GrandTotalBox" Style="{StaticResource ReadOnly}"
                     Background="White" FontSize="26"
                     Text="{Binding GrandTotal, Mode=OneWay, Converter={StaticResource Number}}" />

            <!-- 4 Bayar (large) -->
            <TextBlock x:Name="BayarLabel" Grid.Row="4" Text="{Binding BayarLabel}" Style="{StaticResource Label}" />
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="BayarBox" Style="{StaticResource Input}" FontSize="26" Padding="3,4"
                     infra:MoneyBox.IsEnabled="True"
                     infra:FocusBehavior.Key="bayar" infra:EnterNavigation.SubmitCommand="{Binding BayarEnterCommand}"
                     Text="{Binding BayarText, UpdateSourceTrigger=PropertyChanged}" />

            <!-- 5 Kembali (large, right aligned) -->
            <TextBlock x:Name="ChangeLabel" Grid.Row="5" Text="{Binding ChangeLabel}" Style="{StaticResource DimLabel}" />
            <TextBox Grid.Row="5" Grid.Column="1" x:Name="ChangeBox" Style="{StaticResource ReadOnly}"
                     Background="White" FontSize="30" TextAlignment="Right"
                     Text="{Binding Change, Mode=OneWay, Converter={StaticResource Number}}" />

            <!-- 6 Keterangan -->
            <TextBlock Grid.Row="6" Text="Keterangan" Style="{StaticResource Label}" />
            <TextBox Grid.Row="6" Grid.Column="1" x:Name="NotesBox" Style="{StaticResource Input}"
                     infra:FocusBehavior.Key="notes" infra:EnterNavigation.SubmitCommand="{Binding SaveCommand}"
                     Text="{Binding NotesText, UpdateSourceTrigger=PropertyChanged}" />

            <!-- 7 Referensi (only DEBIT / QRIS / TRANSFER) -->
            <TextBlock Grid.Row="7" Text="Referensi">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Label}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsReferenceEnabled}" Value="False">
                                <Setter Property="Foreground" Value="#8A8A8A" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBox Grid.Row="7" Grid.Column="1" x:Name="ReferenceBox" Style="{StaticResource Input}"
                     IsEnabled="{Binding IsReferenceEnabled}"
                     infra:FocusBehavior.Key="reference" infra:EnterNavigation.SubmitCommand="{Binding SaveCommand}"
                     Text="{Binding ReferenceText, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <TextBlock x:Name="ErrorText" Text="{Binding ErrorMessage}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,6,0,0"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource VisibleWhenText}}" />
        <TextBlock Text="Enter = simpan   ·   F4 = member   ·   Esc = batal" Foreground="Gray" FontSize="11" Margin="0,6,0,0" />
    </StackPanel>
</Window>
