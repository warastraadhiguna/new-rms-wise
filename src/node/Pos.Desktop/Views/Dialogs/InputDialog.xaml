<Window x:Class="Pos.Desktop.Views.Dialogs.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Pos.Desktop.Infrastructure"
        Title="{Binding Title}" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Tahoma" FontSize="13"
        infra:DialogCloser.DialogResult="{Binding DialogResult}"
        FocusManager.FocusedElement="{Binding ElementName=ValueBox}">
    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding OkCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>
    <StackPanel Margin="16">
        <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" Margin="0,0,0,6" />
        <TextBox x:Name="ValueBox" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Padding="3" />
        <TextBlock x:Name="ErrorText" Text="{Binding ErrorMessage}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,6,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="OkButton" Content="OK [Enter]" Command="{Binding OkCommand}" Padding="12,3" Margin="0,0,8,0" />
            <Button x:Name="CancelButton" Content="Batal [Esc]" Command="{Binding CancelCommand}" Padding="12,3" />
        </StackPanel>
    </StackPanel>
</Window>
