<UserControl x:Class="Pos.Desktop.Views.StockTotalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Pos.Desktop.Infrastructure"
             FontFamily="Tahoma" FontSize="13" Background="#EEF3FA"
             infra:FocusBehavior.Request="{Binding FocusRequest}">
    <UserControl.InputBindings>
        <KeyBinding Key="F8" Command="{Binding ExportCommand}" />
        <KeyBinding Key="F9" Command="{Binding OpenStockCardCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <infra:BindingProxy x:Key="Proxy" Data="{Binding}" />
        <infra:VisibleWhenTrueConverter x:Key="VisibleWhenTrue" />
        <infra:VisibleWhenTextConverter x:Key="VisibleWhenText" />
        <Style x:Key="Right" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="RowHeight" Value="22" />
            <Setter Property="RowHeaderWidth" Value="14" />
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HorizontalGridLinesBrush" Value="#D5DCE6" />
            <Setter Property="VerticalGridLinesBrush" Value="#D5DCE6" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinWidth" Value="130" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Text="Form Stok Total" FontSize="24" FontWeight="Bold" Margin="0,4,0,12" />

        <!-- Cari ... | Lokasi -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="240" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Cari" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="SearchBox" Grid.Column="1" Padding="2" infra:FocusBehavior.Key="search"
                     infra:SearchNavigation.Results="{Binding ElementName=RowsGrid}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding OpenStockCheckCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <TextBlock Grid.Column="2" Text="Lokasi" VerticalAlignment="Center" Margin="16,0,8,0" />
            <ComboBox x:Name="LocationBox" Grid.Column="3" ItemsSource="{Binding Locations}" DisplayMemberPath="Display"
                      SelectedItem="{Binding SelectedLocation}" />
        </Grid>

        <!-- bottom: Atur Tampilan, buttons, counts and messages -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <GroupBox x:Name="ViewOptionsGroup" DockPanel.Dock="Left" Header="Atur Tampilan" FontSize="11" Padding="4">
                <UniformGrid Columns="4">
                    <CheckBox x:Name="ShowCategoryBox" Content="Jenis Barang" IsChecked="{Binding ShowCategory}" Margin="2" />
                    <CheckBox x:Name="ShowBrandBox" Content="Merek" IsChecked="{Binding ShowBrand}" Margin="2" />
                    <CheckBox x:Name="ShowShelfBox" Content="Letak Barang" IsChecked="{Binding ShowShelf}" Margin="2" />
                    <CheckBox x:Name="ShowUnitBox" Content="Satuan" IsChecked="{Binding ShowUnit}" Margin="2" />
                </UniformGrid>
            </GroupBox>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="StockCheckButton" Content="Cek Stok [Enter]" Command="{Binding OpenStockCheckCommand}" />
                <Button x:Name="StockCardButton" Content="Kartu Stok [F9]" Command="{Binding OpenStockCardCommand}" />
                <Button x:Name="ExportButton" Content="Export to File [F8]" Command="{Binding ExportCommand}" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Margin="12,0">
                <TextBlock x:Name="CountText" Text="{Binding CountText}" Foreground="#555" />
                <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}" Foreground="Firebrick" TextWrapping="Wrap"
                           Visibility="{Binding StatusMessage, Converter={StaticResource VisibleWhenText}}" />
            </StackPanel>
        </DockPanel>

        <DataGrid x:Name="RowsGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}">
            <DataGrid.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding OpenStockCheckCommand}" />
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenStockCheckCommand}" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Kode Barang" Binding="{Binding Sku}" Width="110" />
                <DataGridTextColumn Header="Nama Barang" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Jenis Barang" Binding="{Binding Category}" Width="120"
                                    Visibility="{Binding Data.ShowCategory, Source={StaticResource Proxy}, Converter={StaticResource VisibleWhenTrue}}" />
                <DataGridTextColumn Header="Merek" Binding="{Binding Brand}" Width="110"
                                    Visibility="{Binding Data.ShowBrand, Source={StaticResource Proxy}, Converter={StaticResource VisibleWhenTrue}}" />
                <DataGridTextColumn Header="Letak Barang" Binding="{Binding ShelfLocation}" Width="90"
                                    Visibility="{Binding Data.ShowShelf, Source={StaticResource Proxy}, Converter={StaticResource VisibleWhenTrue}}" />
                <DataGridTextColumn Header="Lokasi" Binding="{Binding LocationCode}" Width="90" />
                <DataGridTextColumn Header="Satuan" Binding="{Binding BaseUnitCode}" Width="60"
                                    Visibility="{Binding Data.ShowUnit, Source={StaticResource Proxy}, Converter={StaticResource VisibleWhenTrue}}" />
                <DataGridTextColumn Header="Stok" Binding="{Binding StockText}" Width="130" ElementStyle="{StaticResource Right}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
