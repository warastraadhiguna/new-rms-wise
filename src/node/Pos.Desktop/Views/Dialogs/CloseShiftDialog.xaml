<Window x:Class="Pos.Desktop.Views.Dialogs.CloseShiftDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Pos.Desktop.Infrastructure"
        Title="Tutup Shift" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Tahoma" FontSize="13" Background="#EEF3FA"
        infra:DialogCloser.DialogResult="{Binding DialogResult}"
        infra:FocusBehavior.Request="{Binding FocusRequest}">
    <!-- Enter = Simpan (before closing) / Selesai (after); F5 = Cetak Ulang; Esc = Batal / Selesai. -->
    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding EnterCommand}" />
        <KeyBinding Key="F5" Command="{Binding ReprintCommand}" />
        <KeyBinding Key="Escape" Command="{Binding EscapeCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <infra:VisibleWhenTextConverter x:Key="VisibleWhenText" />
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="MinWidth" Value="110" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="18">
        <TextBlock Text="Tutup Shift" FontSize="22" FontWeight="Bold" Margin="0,0,0,8" />
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="No Shift" />
            <TextBlock x:Name="ShiftNumberText" Grid.Column="1" Text="{Binding ShiftNumber}" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Text="Kasir" />
            <TextBlock x:Name="CashierText" Grid.Row="1" Grid.Column="1" Text="{Binding CashierName}" FontWeight="SemiBold" />
            <TextBlock Grid.Row="2" Text="Dibuka" />
            <TextBlock x:Name="OpenedText" Grid.Row="2" Grid.Column="1" Text="{Binding OpenedText}" />
        </Grid>

        <!-- Kas Fisik and Keterangan (locked after closing) -->
        <Border Background="White" BorderBrush="#C9D3E0" BorderThickness="1" Padding="10" IsEnabled="{Binding CanEdit}">
            <StackPanel>
                <TextBlock x:Name="BlindHint" Foreground="#4A5A70" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Hitung uang di laci, lalu isi Kas Fisik. Angka sistem tampil setelah disimpan."
                           Visibility="{Binding IsBlindHint, Converter={StaticResource BoolToVisibility}}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Kas Fisik (Rp)" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBox x:Name="CountedBox" Grid.Column="1" infra:MoneyBox.IsEnabled="True" infra:FocusBehavior.Key="counted"
                             Text="{Binding CountedText, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="18" Padding="4" TextAlignment="Right" Margin="0,0,0,6" />
                    <TextBlock x:Name="NotesLabel" Grid.Row="1" Text="{Binding NotesLabel}" VerticalAlignment="Center" />
                    <TextBox x:Name="NotesBox" Grid.Row="1" Grid.Column="1" infra:FocusBehavior.Key="notes" Padding="3"
                             Text="{Binding NotesText, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Summary: after closing, or before it when blind count is off -->
        <Border x:Name="SummaryPanel" Background="White" BorderBrush="#C9D3E0" BorderThickness="1" Padding="10" Margin="0,10,0,0"
                Visibility="{Binding HasFigures, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        <RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="Modal Awal" />
                    <TextBlock x:Name="OpeningValue" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding OpeningText}" />
                    <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Penjualan Tunai" />
                    <TextBlock x:Name="CashSalesValue" Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding CashSalesText}" />
                    <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Uang Muka Kredit" />
                    <TextBlock x:Name="DownPaymentValue" Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding DownPaymentText}" />
                    <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Pelunasan Piutang Tunai" />
                    <TextBlock x:Name="ReceivableValue" Grid.Row="3" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding ReceivableText}" />
                    <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Pengeluaran Kas" />
                    <TextBlock x:Name="ExpensesValue" Grid.Row="4" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding ExpensesText}" />
                    <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="Retur Tunai" />
                    <TextBlock x:Name="RefundsValue" Grid.Row="5" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding RefundsText}" />
                    <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="Kas Seharusnya" FontWeight="Bold" />
                    <TextBlock x:Name="ExpectedValue" Grid.Row="6" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding ExpectedText}" FontWeight="Bold" />
                </Grid>

                <!-- after closing: counted cash and the coloured difference -->
                <Grid x:Name="ResultPanel" Visibility="{Binding IsClosed, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="Kas Fisik" FontWeight="Bold" />
                    <TextBlock x:Name="CountedValue" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding CountedCashText}" FontWeight="Bold" />
                    <Border x:Name="DifferenceRow" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0" Padding="4,3">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#EEF1F5" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DifferenceKind}" Value="Over">
                                        <Setter Property="Background" Value="#DFF3E3" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DifferenceKind}" Value="Short">
                                        <Setter Property="Background" Value="#FBE0E0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <TextBlock x:Name="DifferenceValue" DockPanel.Dock="Right" Text="{Binding DifferenceText}" FontSize="18" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="Black" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DifferenceKind}" Value="Over">
                                                <Setter Property="Foreground" Value="#1E6B2E" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DifferenceKind}" Value="Short">
                                                <Setter Property="Foreground" Value="Firebrick" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock x:Name="DifferenceLabel" Text="{Binding DifferenceLabel}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </Grid>

                <TextBlock Text="Non Tunai (jumlah nota)" Foreground="#4A5A70" Margin="0,10,0,2" />
                <ItemsControl x:Name="NonCashList" ItemsSource="{Binding NonCash}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,1">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding AmountText}" />
                                <TextBlock>
                                    <Run Text="{Binding Name, Mode=OneWay}" /> <Run Text="(" /><Run Text="{Binding Count, Mode=OneWay}" /><Run Text=")" />
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <DockPanel Margin="0,8,0,0">
                    <TextBlock x:Name="SaleCountValue" DockPanel.Dock="Right" Text="{Binding SaleCountText}" />
                    <TextBlock Text="Jumlah Nota" />
                </DockPanel>
                <DockPanel>
                    <TextBlock x:Name="CancellationCountValue" DockPanel.Dock="Right" Text="{Binding CancellationCountText}" />
                    <TextBlock Text="Jumlah Pembatalan" />
                </DockPanel>
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,10,0,0"
                   Visibility="{Binding StatusMessage, Converter={StaticResource VisibleWhenText}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="SaveButton" Content="Simpan [Enter]" Command="{Binding SaveCommand}"
                    Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
            <Button x:Name="CancelButton" Content="Batal [Esc]" Command="{Binding EscapeCommand}"
                    Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
            <Button x:Name="ReprintButton" Content="Cetak Ulang [F5]" Command="{Binding ReprintCommand}"
                    Visibility="{Binding IsClosed, Converter={StaticResource BoolToVisibility}}" />
            <Button x:Name="FinishButton" Content="Selesai [Enter]" Command="{Binding FinishCommand}" infra:FocusBehavior.Key="finish"
                    Visibility="{Binding IsClosed, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </StackPanel>
</Window>
