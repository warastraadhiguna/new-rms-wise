{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "StockIntegrity": {
    "Enabled": true,
    "RunOnStartup": true,
    "DailyAt": "02:00"
  },
  "Sync": {
    "HqUrl": "",
    "IntervalSeconds": 30,
    "MaxBackoffSeconds": 300,
    "PushBatchSize": 100,
    "PullLimit": 500,
    "RequestTimeoutSeconds": 60
  }
}
