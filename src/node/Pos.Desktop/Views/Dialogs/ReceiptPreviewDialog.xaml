<Window x:Class="Pos.Desktop.Views.Dialogs.ReceiptPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Pos.Desktop.Infrastructure"
        Title="Pratinjau Struk" SizeToContent="WidthAndHeight" ResizeMode="NoResize" MaxHeight="760"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Tahoma" FontSize="13"
        infra:DialogCloser.DialogResult="{Binding DialogResult}"
        FocusManager.FocusedElement="{Binding ElementName=CloseButton}">
    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding CloseCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </Window.InputBindings>
    <DockPanel Margin="14">
        <TextBlock x:Name="MessageText" DockPanel.Dock="Top" Text="{Binding Message}" Foreground="Firebrick"
                   TextWrapping="Wrap" MaxWidth="420" Margin="0,0,0,10" />
        <Button x:Name="CloseButton" DockPanel.Dock="Bottom" Content="Tutup [Enter]" Command="{Binding CloseCommand}"
                HorizontalAlignment="Right" Padding="16,4" Margin="0,10,0,0" />
        <!-- Monospace and no wrapping: the dashed rules are exactly the paper width. -->
        <TextBox x:Name="ReceiptBox" Text="{Binding ReceiptText, Mode=OneWay}" IsReadOnly="True"
                 FontFamily="Consolas, Courier New" FontSize="13" TextWrapping="NoWrap" Padding="8"
                 HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="600"
                 Background="White" />
    </DockPanel>
</Window>
