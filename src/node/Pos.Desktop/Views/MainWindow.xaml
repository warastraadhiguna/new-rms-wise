<Window x:Class="Pos.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Pos.Desktop.Views"
        xmlns:vm="clr-namespace:Pos.Desktop.ViewModels"
        Title="{Binding NodeName, StringFormat=Kasir - {0}}" Width="1366" Height="768"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        FontFamily="Tahoma" FontSize="13" Background="#DCE6F4">
    <Window.InputBindings>
        <KeyBinding Key="F2" Command="{Binding OpenSalesFormCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <DataTemplate DataType="{x:Type vm:SalesViewModel}">
            <views:SalesView />
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Kasir:" />
                    <Run Text="{Binding CashierName, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Shift:" />
                    <Run Text="{Binding ShiftNumber, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Toko:" />
                    <Run Text="{Binding NodeName, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

        <!-- Tab strip like RMS 2: "Form Penjualan 1 ×" -->
        <Border DockPanel.Dock="Top" Background="#DCE6F4" Padding="4,4,4,0">
            <StackPanel Orientation="Horizontal">
                <Border Background="White" BorderBrush="#9DB3D2" BorderThickness="1,1,1,0" Padding="8,2"
                        Visibility="{Binding IsSalesFormOpen, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Form Penjualan 1" VerticalAlignment="Center" />
                        <Button x:Name="CloseTabButton" Content="×" Command="{Binding CloseSalesFormCommand}" Margin="8,0,0,0"
                                Padding="4,0" BorderThickness="0" Background="Transparent" Focusable="False" ToolTip="Tutup [Esc]" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Grid>
            <ContentControl x:Name="FormHost" Content="{Binding SalesForm}" Focusable="False" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSalesFormOpen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Button x:Name="OpenSalesButton" Content="Form Penjualan [F2]" Command="{Binding OpenSalesFormCommand}"
                        Padding="16,6" FontSize="15" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
