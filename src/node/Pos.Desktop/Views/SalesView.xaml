<UserControl x:Class="Pos.Desktop.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Pos.Desktop.Infrastructure"
             FontFamily="Tahoma" FontSize="13"
             Background="#EEF3FA"
             infra:FocusBehavior.Request="{Binding FocusRequest}"
             infra:TextInputCommand.Text="*"
             infra:TextInputCommand.Command="{Binding StartMultiplierCommand}">
    <!-- Keys follow RMS 2 "Form Penjualan". "*" (numpad or Shift+8) is handled by TextInputCommand above. -->
    <UserControl.InputBindings>
        <KeyBinding Key="F1" Command="{Binding OpenProductSearchCommand}" />
        <!-- F3 is new (not in RMS 2): hide/show the Data panel. -->
        <KeyBinding Key="F3" Command="{Binding ToggleDataPanelCommand}" />
        <KeyBinding Key="F4" Command="{Binding PickCustomerCommand}" />
        <KeyBinding Key="F5" Command="{Binding ReprintCommand}" />
        <KeyBinding Key="F6" Command="{Binding PayCommand}" />
        <KeyBinding Key="F8" Command="{Binding ChangeQtyCommand}" />
        <KeyBinding Key="Delete" Modifiers="Shift" Command="{Binding DeleteLineCommand}" />
        <KeyBinding Key="F12" Command="{Binding CancelTransactionCommand}" />
        <KeyBinding Key="Escape" Command="{Binding EscapeCommand}" />
        <KeyBinding Key="O" Modifiers="Ctrl+Shift" Command="{Binding UnlockDeleteCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <infra:BindingProxy x:Key="Proxy" Data="{Binding}" />
        <infra:IndonesianNumberConverter x:Key="Number" />
        <infra:VisibleWhenTrueConverter x:Key="VisibleWhenTrue" />
        <infra:GridLengthWhenTrueConverter x:Key="DataColumnWidth" WhenTrue="4*" WhenFalse="Auto" />
        <infra:GridLengthWhenTrueConverter x:Key="TransactionColumnWidth" WhenTrue="6*" WhenFalse="*" />
        <infra:VisibleWhenTextConverter x:Key="VisibleWhenText" />
        <Style x:Key="Right" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="RowHeight" Value="22" />
            <Setter Property="RowHeaderWidth" Value="14" />
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HorizontalGridLinesBrush" Value="#D5DCE6" />
            <Setter Property="VerticalGridLinesBrush" Value="#D5DCE6" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="6" />
            <Setter Property="BorderBrush" Value="#9DB3D2" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinWidth" Value="130" />
        </Style>
    </UserControl.Resources>

    <!-- Layout after the owner's revision: left = only the "Data" panel (product grid + Atur Tampilan);
         right = Member and "Cari [F1] ... x [qty]" above "Transaksi" (large total, cart, buttons).
         F3 / the edge button hides the left panel completely, so Transaksi spans the window. -->
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding IsDataPanelVisible, Converter={StaticResource DataColumnWidth}}" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="{Binding IsDataPanelVisible, Converter={StaticResource TransactionColumnWidth}}" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.ColumnSpan="3" Text="Form Penjualan" FontSize="24" FontWeight="Bold" Margin="0,4,0,12" />

        <!-- Left: Data (product grid + Atur Tampilan) -->
        <GroupBox x:Name="DataPanel" Grid.Row="1" Grid.Column="0" Header="Data"
                  Visibility="{Binding IsDataPanelVisible, Converter={StaticResource VisibleWhenTrue}}">
            <DockPanel>
                <GroupBox x:Name="ViewOptionsGroup" DockPanel.Dock="Bottom" Header="Atur Tampilan" Margin="0,8,0,0" FontSize="11">
                    <UniformGrid Columns="3" Rows="2">
                        <CheckBox x:Name="ShowBrandBox" Content="Merek" IsChecked="{Binding ShowBrand}" Margin="2" />
                        <CheckBox x:Name="ShowShelfBox" Content="Letak" IsChecked="{Binding ShowShelf}" Margin="2" />
                        <CheckBox x:Name="ShowStockBox" Content="Stok" IsChecked="{Binding ShowStock}" Margin="2" />
                        <CheckBox x:Name="ShowCategoryBox" Content="Jenis Barang" IsChecked="{Binding ShowCategory}" Margin="2" />
                        <CheckBox x:Name="ShowDiscountPriceBox" Content="Harga Diskon" IsChecked="{Binding ShowDiscountPrice}" Margin="2" />
                        <CheckBox x:Name="ShowUnitBox" Content="Satuan" IsChecked="{Binding ShowUnit}" Margin="2" />
                    </UniformGrid>
                </GroupBox>

                <DataGrid x:Name="ProductGrid" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}">
                    <DataGrid.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AddSelectedProductCommand}" />
                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding AddSelectedProductCommand}" />
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kode Barang" Binding="{Binding Sku}" Width="90" />
                        <DataGridTextColumn Header="Nama Barang" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Satuan" Binding="{Binding UnitCode}" Width="60"
                                            Visibility="{Binding Data.ShowUnit, Source={StaticResource Proxy}, Converter={StaticResource VisibleWhenTrue}}" />
                        <DataGridTextColumn Header="Harga Jual" Width="80" ElementStyle="{StaticResource Right}"
                                            Binding="{Binding Price, Converter={StaticResource Number}}" />
                        <DataGridTextColumn Header="Merek" Binding="{Binding Brand}" Width="80"
                                            Visibility="{Binding Data.ShowBrand, Source={StaticResource Proxy}, Converter={StaticResource VisibleWhenTrue}}" />
                        <DataGridTextColumn Header="Letak" Binding="{Binding ShelfLocation}" Width="60"
                                            Visibility="{Binding Data.ShowShelf, Source={StaticResource Proxy}, Converter={StaticResource VisibleWhenTrue}}" />
                        <DataGridTextColumn Header="Stok" Width="110" ElementStyle="{StaticResource Right}"
                                            Binding="{Binding StockText}"
                                            Visibility="{Binding Data.ShowStock, Source={StaticResource Proxy}, Converter={StaticResource VisibleWhenTrue}}" />
                        <DataGridTextColumn Header="Jenis Barang" Binding="{Binding Category}" Width="90"
                                            Visibility="{Binding Data.ShowCategory, Source={StaticResource Proxy}, Converter={StaticResource VisibleWhenTrue}}" />
                        <DataGridTextColumn Header="Harga Diskon" Width="80" ElementStyle="{StaticResource Right}"
                                            Binding="{Binding DiscountPrice, Converter={StaticResource Number}}"
                                            Visibility="{Binding Data.ShowDiscountPrice, Source={StaticResource Proxy}, Converter={StaticResource VisibleWhenTrue}}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>

        <!-- Small button on the panel edge (same as F3) -->
        <Button x:Name="DataPanelToggle" Grid.Row="1" Grid.Column="1" MinWidth="0" Width="14" Height="56" Padding="0" FontSize="9"
                VerticalAlignment="Center" HorizontalAlignment="Center" Focusable="False"
                Command="{Binding ToggleDataPanelCommand}">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Content" Value="◀" />
                    <Setter Property="ToolTip" Value="Sembunyikan panel Data [F3]" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDataPanelVisible}" Value="False">
                            <Setter Property="Content" Value="▶" />
                            <Setter Property="ToolTip" Value="Tampilkan panel Data [F3]" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- Right: Member, Cari [F1] ... x [qty], then Transaksi -->
        <DockPanel x:Name="RightPanel" Grid.Row="1" Grid.Column="2">
            <!-- Member [F4] and Cari [F1] share one grid: same label column, text boxes aligned left and right,
                 "..." exactly above the "x" qty box. -->
            <Grid x:Name="SearchArea" DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="56" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="MemberLabel" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Hyperlink Command="{Binding PickCustomerCommand}">Member [F4]</Hyperlink>
                </TextBlock>
                <TextBox x:Name="MemberBox" Grid.Row="0" Grid.Column="1" Padding="2"
                         Text="{Binding CustomerText, UpdateSourceTrigger=PropertyChanged}"
                         infra:FocusBehavior.Key="member">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding MemberEnterCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button x:Name="PickCustomerButton" Grid.Row="0" Grid.Column="3" Content="..." MinWidth="0" Padding="0"
                        Command="{Binding PickCustomerCommand}" />

                <TextBlock x:Name="SearchLabel" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Hyperlink Command="{Binding OpenProductSearchCommand}">Cari [F1]</Hyperlink>
                </TextBlock>
                <TextBox x:Name="SearchBox" Grid.Row="2" Grid.Column="1" Padding="2" infra:FocusBehavior.Key="search"
                         infra:SearchNavigation.Results="{Binding ElementName=ProductGrid}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchEnterCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="x" VerticalAlignment="Center" Margin="6,0" />
                <TextBox x:Name="QtyBox" Grid.Row="2" Grid.Column="3" Padding="2" TextAlignment="Left"
                         infra:FocusBehavior.Key="qty"
                         Text="{Binding QtyText, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMultiplierMode}" Value="True">
                                    <Setter Property="Background" Value="#FFF2B3" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding QtyEnterCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </Grid>

            <GroupBox x:Name="TransactionGroup" Header="Transaksi">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="White" BorderBrush="#C8D3E3" BorderThickness="1" Margin="0,0,0,6">
                        <TextBlock x:Name="TotalText" Text="{Binding Total, Converter={StaticResource Number}}"
                                   FontSize="34" FontWeight="Bold" Foreground="#7F7F7F" HorizontalAlignment="Right" Margin="8,2" />
                    </Border>

                    <UniformGrid DockPanel.Dock="Bottom" Columns="4" Margin="0,8,0,0">
                        <Button x:Name="PayButton" Content="Bayar [F6]" Command="{Binding PayCommand}" Margin="2" />
                        <Button x:Name="ChangeQtyButton" Content="Atur Jumlah [F8]" Command="{Binding ChangeQtyCommand}" Margin="2" />
                        <Button x:Name="DeleteButton" Content="Hapus [SHF DEL]" Command="{Binding DeleteLineCommand}" Margin="2" />
                        <Button x:Name="CancelButton" Content="Batal [F12]" Command="{Binding CancelTransactionCommand}" Margin="2" />
                    </UniformGrid>

                    <DataGrid x:Name="CartGrid" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="No" Binding="{Binding No}" Width="40" />
                            <DataGridTextColumn Header="Kode Barang" Binding="{Binding Code}" Width="100" />
                            <DataGridTextColumn Header="Nama Barang" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="QTY" Width="55" ElementStyle="{StaticResource Right}"
                                                Binding="{Binding Qty, Converter={StaticResource Number}, ConverterParameter=qty}" />
                            <DataGridTemplateColumn Header="Satuan" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="▾" MinWidth="0" Padding="2,0" FontSize="9"
                                                    ToolTip="Ganti satuan" Focusable="False"
                                                    Command="{Binding DataContext.ChangeUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <TextBlock Text="{Binding UnitCode}" VerticalAlignment="Center" Margin="2,0" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Harga" Width="80" ElementStyle="{StaticResource Right}"
                                                Binding="{Binding Price, Converter={StaticResource Number}}" />
                            <DataGridTextColumn Header="Sub Total" Width="95" ElementStyle="{StaticResource Right}"
                                                Binding="{Binding SubTotal, Converter={StaticResource Number}}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>
        </DockPanel>

        <!-- Messages under the form -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,6,0,0">
            <TextBlock x:Name="WarningText" Text="{Binding WarningMessage}" Foreground="#B35C00" TextWrapping="Wrap"
                       Visibility="{Binding WarningMessage, Converter={StaticResource VisibleWhenText}}" />
            <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}" Foreground="Firebrick" TextWrapping="Wrap"
                       Visibility="{Binding StatusMessage, Converter={StaticResource VisibleWhenText}}" />
        </StackPanel>
    </Grid>
</UserControl>
