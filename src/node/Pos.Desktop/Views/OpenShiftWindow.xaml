<Window x:Class="Pos.Desktop.Views.OpenShiftWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buka Shift" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FocusManager.FocusedElement="{Binding ElementName=OpeningCashBox}">
    <!-- Enter = Buka Shift from anywhere in the window. -->
    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding OpenShiftCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock Text="Buka Shift" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock Margin="0,0,0,16">
            <Run Text="Kasir:" />
            <Run Text="{Binding CashierName, Mode=OneWay}" FontWeight="SemiBold" />
        </TextBlock>

        <TextBlock Text="Modal awal di laci (Rp)" />
        <TextBox x:Name="OpeningCashBox" Text="{Binding OpeningCashText, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="18" Padding="6" Margin="0,4,0,4" TextAlignment="Right" />
        <TextBlock Text="Contoh: 200.000" Foreground="Gray" Margin="0,0,0,12" />

        <TextBlock Text="{Binding ErrorMessage}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,0,0,8" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CancelButton" Grid.Column="0" Content="Batal (Keluar)" Command="{Binding CancelCommand}" IsCancel="True"
                    FontSize="16" Padding="10,6" />
            <Button x:Name="OpenShiftButton" Grid.Column="2" Content="Buka Shift (Enter)" Command="{Binding OpenShiftCommand}"
                    FontSize="16" Padding="10,6" />
        </Grid>
        <TextBlock Text="Memproses..." Margin="0,8,0,0" HorizontalAlignment="Center"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>
</Window>
