<Window x:Class="Pos.Desktop.Views.Dialogs.SaleResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Pos.Desktop.Infrastructure"
        Title="Transaksi Berhasil" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Tahoma" FontSize="13"
        infra:DialogCloser.DialogResult="{Binding DialogResult}">
    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding CloseCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <infra:IndonesianNumberConverter x:Key="Number" />
        <infra:VisibleWhenTextConverter x:Key="VisibleWhenText" />
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock Text="Nota" Foreground="Gray" />
        <TextBlock x:Name="NumberText" Text="{Binding Number}" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />
        <TextBlock Text="Total" Foreground="Gray" />
        <TextBlock x:Name="TotalText" Text="{Binding Total, Converter={StaticResource Number}}" FontSize="20" Margin="0,0,0,12" />
        <TextBlock Text="Kembali" Foreground="Gray" />
        <TextBlock x:Name="ChangeText" Text="{Binding Change, Converter={StaticResource Number}}"
                   FontSize="40" FontWeight="Bold" Foreground="#1E6B2E" />
        <TextBlock x:Name="WarningText" Text="{Binding Warnings}" Foreground="#B35C00" TextWrapping="Wrap" Margin="0,10,0,0"
                   Visibility="{Binding Warnings, Converter={StaticResource VisibleWhenText}}" />
        <Button x:Name="OkButton" Content="OK [Enter]" Command="{Binding CloseCommand}" HorizontalAlignment="Right"
                Padding="16,4" Margin="0,14,0,0" />
    </StackPanel>
</Window>
