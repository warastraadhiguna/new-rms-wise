<UserControl x:Class="Pos.Desktop.Views.ReturnListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Pos.Desktop.Infrastructure"
             FontFamily="Tahoma" FontSize="13" Background="#EEF3FA"
             infra:FocusBehavior.Request="{Binding FocusRequest}">
    <!-- F1 Tambah Retur, F11 / Enter Lihat Retur, F5 Cetak Ulang, Esc close. -->
    <UserControl.InputBindings>
        <KeyBinding Key="F1" Command="{Binding NewReturnCommand}" />
        <KeyBinding Key="F11" Command="{Binding ViewCommand}" />
        <KeyBinding Key="F5" Command="{Binding ReprintCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <infra:VisibleWhenTextConverter x:Key="VisibleWhenText" />
        <Style x:Key="Right" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Text="Data Retur Penjualan" FontSize="24" FontWeight="Bold" Margin="0,4,0,12" />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <StackPanel.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding ShowCommand}" />
            </StackPanel.InputBindings>
            <TextBlock Text="Tanggal" VerticalAlignment="Center" Margin="0,0,8,0" />
            <DatePicker x:Name="FromBox" SelectedDate="{Binding FromDate}" Width="130" />
            <TextBlock Text="s/d" VerticalAlignment="Center" Margin="8,0" />
            <DatePicker x:Name="ToBox" SelectedDate="{Binding ToDate}" Width="130" />
            <Button x:Name="ShowButton" Content="Tampilkan [Enter]" Command="{Binding ShowCommand}" Margin="8,0,0,0" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="NewButton" Content="Tambah Retur [F1]" Command="{Binding NewReturnCommand}" />
                <Button x:Name="ViewButton" Content="Lihat Retur [F11]" Command="{Binding ViewCommand}" />
                <Button x:Name="ReprintButton" Content="Cetak Ulang [F5]" Command="{Binding ReprintCommand}" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="CountText" Text="{Binding CountText}" Foreground="#555" />
                <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}" Foreground="Firebrick" TextWrapping="Wrap"
                           Visibility="{Binding StatusMessage, Converter={StaticResource VisibleWhenText}}" />
            </StackPanel>
        </DockPanel>

        <DataGrid x:Name="RowsGrid" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" infra:FocusBehavior.Key="rows"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                  RowHeight="22" RowHeaderWidth="14" GridLinesVisibility="All" Background="White"
                  HorizontalGridLinesBrush="#D5DCE6" VerticalGridLinesBrush="#D5DCE6">
            <DataGrid.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding ViewCommand}" />
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding ViewCommand}" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn Header="No Retur" Binding="{Binding Number}" Width="170" />
                <DataGridTextColumn Header="Tanggal" Binding="{Binding TimeText}" Width="120" />
                <DataGridTextColumn Header="No Nota" Binding="{Binding SaleNumber}" Width="170" />
                <DataGridTextColumn Header="Member" Binding="{Binding CustomerName}" Width="140" />
                <DataGridTextColumn Header="Kasir" Binding="{Binding CreatedByName}" Width="120" />
                <DataGridTextColumn Header="Penyelesaian" Binding="{Binding SettlementText}" Width="170" />
                <DataGridTextColumn Header="Total Retur" Binding="{Binding TotalText}" Width="95" ElementStyle="{StaticResource Right}" />
                <DataGridTextColumn Header="Keterangan" Binding="{Binding Notes}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
