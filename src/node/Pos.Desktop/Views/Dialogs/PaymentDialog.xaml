<Window x:Class="Pos.Desktop.Views.Dialogs.PaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Pos.Desktop.Infrastructure"
        Title="Bayar Nota" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Tahoma" FontSize="13" Background="#EEF3FA"
        infra:DialogCloser.DialogResult="{Binding DialogResult}"
        infra:FocusBehavior.Request="{Binding FocusRequest}"
        infra:EnterNavigation.IsEnabled="True">
    <!-- RMS 2 BayarNotaForm: Enter moves to the next field; Enter on Keterangan saves. -->
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <infra:IndonesianNumberConverter x:Key="Number" />
        <infra:VisibleWhenTextConverter x:Key="VisibleWhenText" />
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4,10,4" />
        </Style>
        <Style x:Key="Amount" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Background" Value="#F7F9FC" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Padding" Value="3" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock Text="{Binding CustomerName, StringFormat=Member: {0}}" Margin="0,0,0,8" FontWeight="SemiBold"
                   Visibility="{Binding CustomerName, Converter={StaticResource VisibleWhenText}}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Grand Total" Style="{StaticResource Label}" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="GrandTotalBox" Style="{StaticResource Amount}"
                     Text="{Binding GrandTotal, Mode=OneWay, Converter={StaticResource Number}}" />

            <TextBlock Grid.Row="1" Text="Cara Bayar" Style="{StaticResource Label}" />
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="MethodBox" infra:FocusBehavior.Key="method" infra:EnterNavigation.Next="discountMode" Margin="0,3"
                      ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding SelectedMethod}" DisplayMemberPath="Name" />

            <ComboBox Grid.Row="2" x:Name="DiscountModeBox" infra:FocusBehavior.Key="discountMode" infra:EnterNavigation.Next="discount" Margin="0,3,10,3"
                      ItemsSource="{Binding DiscountModes}" SelectedIndex="{Binding DiscountModeIndex}" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="DiscountBox" infra:FocusBehavior.Key="discount" infra:EnterNavigation.Next="bayar" Style="{StaticResource Input}"
                     TextAlignment="Right" Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="3" Text="Total" Style="{StaticResource Label}" />
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="TotalBox" Style="{StaticResource Amount}"
                     Text="{Binding Total, Mode=OneWay, Converter={StaticResource Number}}" />

            <TextBlock Grid.Row="4" Text="Bayar" Style="{StaticResource Label}" />
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="BayarBox" infra:FocusBehavior.Key="bayar" infra:EnterNavigation.Next="reference" Style="{StaticResource Input}"
                     FontSize="22" TextAlignment="Right" Text="{Binding BayarText, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="5" Text="Kembali" Style="{StaticResource Label}" />
            <TextBox Grid.Row="5" Grid.Column="1" x:Name="ChangeBox" Style="{StaticResource Amount}" Foreground="#1E6B2E"
                     Text="{Binding Change, Mode=OneWay, Converter={StaticResource Number}}" />

            <TextBlock Grid.Row="6" Text="Referensi" Style="{StaticResource Label}" />
            <TextBox Grid.Row="6" Grid.Column="1" x:Name="ReferenceBox" infra:FocusBehavior.Key="reference" infra:EnterNavigation.Next="notes" Style="{StaticResource Input}"
                     Text="{Binding ReferenceText, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="7" Text="Keterangan" Style="{StaticResource Label}" />
            <TextBox Grid.Row="7" Grid.Column="1" x:Name="NotesBox" infra:FocusBehavior.Key="notes" Style="{StaticResource Input}"
                     infra:EnterNavigation.SubmitCommand="{Binding SaveCommand}"
                     Text="{Binding NotesText, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <TextBlock x:Name="ErrorText" Text="{Binding ErrorMessage}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,8,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="SaveButton" Content="Simpan" Command="{Binding SaveCommand}" Padding="16,4" Margin="0,0,8,0" />
            <Button x:Name="CancelButton" Content="Batal [Esc]" Command="{Binding CancelCommand}" Padding="16,4" />
        </StackPanel>
    </StackPanel>
</Window>
